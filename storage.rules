rules_version = '2';

// Chat attachments (images, voice notes, files) are uploaded under these
// three prefixes by src/components/chat/ChatWindow.tsx, keyed by chatId.
// Any signed-in user can read/write — access is enforced app-side by only
// ever generating/using a chatId for a conversation the two participants
// are actually part of. Everything else stays denied.
service firebase.storage {
  match /b/{bucket}/o {
    match /chatImages/{chatId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /chatFiles/{chatId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /voice/{chatId}/{fileName} {
      allow read, write: if request.auth != null;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
